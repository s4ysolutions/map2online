//| mill-version: 1.3.0
//| mill-jvm-version: system
package build

import mill.*
import mill.scalalib.*
import mill.scalajslib.*
import mill.scalajslib.api.*

/*
 * Dependencies use the `::` platform separator before the version, so one
 * Dep resolves to the JVM artifact in a JVM module and to the `_sjs1`
 * artifact in a Scala.js twin. Twins still declare their own mvnDeps
 * (they do not inherit the parent's), reusing the same Seq.
 */
object Deps:
  val zioVersion = "2.1.27"

  val zio = mvn"dev.zio::zio::$zioVersion"
  val zioTest = mvn"dev.zio::zio-test::$zioVersion"
  val zioTestSbt = mvn"dev.zio::zio-test-sbt::$zioVersion"
  val munit = mvn"org.scalameta::munit::1.3.6"
  val prelude = mvn"dev.zio::zio-prelude::1.0.0-RC48"

  val laminar = mvn"com.raquo::laminar::17.2.1"
  val scalajsDom = mvn"org.scala-js::scalajs-dom::2.8.1"

trait BaseModule extends ScalaModule:
  def scalaVersion = "3.9.0"
  override def scalacOptions = super.scalacOptions() ++ Seq(
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Wunused:all"
  )

trait BaseJvmModule extends BaseModule

/** A source file pointing tests at a fixtures directory on disk. */
def fixturesDirSource(dest: os.Path, dir: os.Path): PathRef =
  os.write.over(
    dest / "FixturesDir.scala",
    s"package fixtures\n\nobject FixturesDir:\n  val path: String = \"$dir\"\n"
  )
  PathRef(dest)

trait BaseJsModule extends BaseModule with ScalaJSModule:
  def scalaJSVersion = "1.22.0"
  override def moduleKind = ModuleKind.ESModule

/*
 **************** core: feature-agnostic shared kernel *****************
 */
object core extends Module:

  // Identifier[A] / Identified[Id, E]; minting lives in the nested module so
  // domain code can carry IDs but never construct them
  object identity extends BaseModule:
    object identityJs extends BaseJsModule:
      override def sources = Task { identity.sources() ++ super.sources() }

    // only infra, presentation and tests depend on this
    object minting extends BaseModule:
      override def moduleDeps = Seq(identity)

      object mintingJs extends BaseJsModule:
        override def sources = Task { minting.sources() ++ super.sources() }
        override def moduleDeps = Seq(identity.identityJs)

  // lenient XML/HTML parsing, HTML -> Markdown, Markdown -> safe HTML
  object markup extends BaseModule:
    object munits extends ScalaTests with TestModule.Munit:
      override def mvnDeps = Seq(Deps.munit)

    object markupJs extends BaseJsModule:
      override def sources = Task { markup.sources() ++ super.sources() }

      object munits extends ScalaJSTests with TestModule.Munit:
        override def sources = Task { markup.munits.sources() ++ super.sources() }
        override def mvnDeps = Seq(Deps.munit)

  object domain extends Module:
    // InfraFailure; no ZIO so pure domains may import it
    object errors extends BaseModule:
      object errorsJs extends BaseJsModule:
        override def sources = Task { errors.sources() ++ super.sources() }

  // UseCaseCommand / UseCase[C] and the ZIO-pinned variant
  object app extends BaseModule:
    private def deps = Seq(Deps.zio)
    override def mvnDeps = deps

    object tests extends ScalaTests with TestModule.ZioTest:
      override def mvnDeps = Seq(Deps.zioTest, Deps.zioTestSbt)

    object appJs extends BaseJsModule:
      override def sources = Task { app.sources() ++ super.sources() }
      override def mvnDeps = deps

  object presentation extends Module:
    // shared Laminar utilities: the ZIO -> Airstream bridge, layout pieces
    object laminar extends BaseJsModule:
      override def mvnDeps = Seq(Deps.zio, Deps.laminar)

/*
 **************** features: one group per bounded context *****************
 */
object features extends Module:

  // Category -> Route -> Feature
  object catalog extends Module:

    // pure: VOs, entities, the Catalog aggregate, operations; no ZIO
    object domain extends BaseModule:
      private def deps = Seq(Deps.prelude)
      override def moduleDeps = Seq(core.identity)
      override def mvnDeps = deps

      object munits extends ScalaTests with TestModule.Munit:
        override def moduleDeps = super.moduleDeps ++ Seq(core.identity.minting)
        override def mvnDeps = Seq(Deps.munit)

      object domainJs extends BaseJsModule:
        override def sources = Task { domain.sources() ++ super.sources() }
        override def moduleDeps = Seq(core.identity.identityJs)
        override def mvnDeps = deps

        // the JVM suites again, run on Node: the browser is where this code runs
        object munits extends ScalaJSTests with TestModule.Munit:
          override def sources = Task { domain.munits.sources() ++ super.sources() }
          override def moduleDeps = super.moduleDeps ++ Seq(core.identity.minting.mintingJs)
          override def mvnDeps = Seq(Deps.munit)

  // KML import/export: reader, writer, fitting KML trees into the catalog
  object kml extends Module:
    private def fixtures = moduleDir / "fixtures"

    // pure: no ZIO; reuses the catalog VOs and core.markup
    object domain extends BaseModule:
      private def deps = Seq(Deps.prelude)
      override def moduleDeps = Seq(features.catalog.domain, core.markup)
      override def mvnDeps = deps

      // fixtures are KML files from the old app's test data; the generated
      // source tells the tests where they are on disk
      object munits extends ScalaTests with TestModule.Munit:
        override def sources = Task.Sources("src", "src-jvm")
        override def generatedSources = Task { Seq(fixturesDirSource(Task.dest, fixtures)) }
        override def moduleDeps = super.moduleDeps ++ Seq(core.identity.minting)
        override def mvnDeps = Seq(Deps.munit)

      object domainJs extends BaseJsModule:
        override def sources = Task { domain.sources() ++ super.sources() }
        override def moduleDeps = Seq(features.catalog.domain.domainJs, core.markup.markupJs)
        override def mvnDeps = deps

        object munits extends ScalaJSTests with TestModule.Munit:
          override def sources =
            Task.Sources(domain.munits.moduleDir / "src", domain.munits.moduleDir / "src-js")
          override def generatedSources = Task { Seq(fixturesDirSource(Task.dest, fixtures)) }
          override def moduleDeps = super.moduleDeps ++ Seq(core.identity.minting.mintingJs)
          override def mvnDeps = Seq(Deps.munit)

/*
 **************** products: composition roots *****************
 */
object products extends Module:

  // The browser application. Bundled by Vite from fastLinkJS / fullLinkJS
  // output (see vite.config.js).
  object web extends BaseJsModule:
    override def moduleDeps = Seq(
      core.app.appJs,
      core.domain.errors.errorsJs,
      core.presentation.laminar
    )
    override def mvnDeps = Seq(Deps.zio, Deps.laminar, Deps.scalajsDom)
    override def mainClass = Some("s4y.map2online.web.Main")
